# Copy to .env and adjust as needed. .env is git-ignored.

# PostgreSQL — consumed by both docker-compose.yml and the Spring Boot app
DB_NAME=threadly
DB_USER=threadly
DB_PASSWORD=threadly
DB_HOST=localhost
DB_PORT=5432

# Backend
SERVER_PORT=8080

# JWT signing — MUST be overridden outside local development (min 32 characters)
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_ISSUER=https://threadly.dev
JWT_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=300
RATE_LIMIT_WRITE_CAPACITY=60
RATE_LIMIT_PERIOD=1m

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google sign-in. Leave empty to keep the endpoint switched off.
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
