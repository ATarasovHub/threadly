# Copy to .env and adjust as needed. .env is git-ignored.

# PostgreSQL — consumed by both docker-compose.yml and the Spring Boot app
DB_NAME=threadly
DB_USER=threadly
DB_PASSWORD=threadly
DB_HOST=localhost
DB_PORT=5432

# Backend
SERVER_PORT=8080

# JWT signing — MUST be overridden outside local development (min 32 characters)
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_ISSUER=https://threadly.dev
JWT_ACCESS_TOKEN_TTL=15m
